# ── Archivist ──────────────────────────────────────────────────────────────

# TMDB — movies (required)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# TVDB — TV series (required)
# https://thetvdb.com/api-information
TVDB_API_KEY=
TVDB_PIN=

# Stop retrying a magnet that cannot obtain BEP 9 metadata, blocklist that
# release, and return its library item to missing so another release can win.
TORRENT_METADATA_TIMEOUT_MINUTES=15

# Google Books — books (optional, falls back to OpenLibrary)
# https://console.cloud.google.com → Books API
GOOGLE_BOOKS_API_KEY=

# ComicVine — comics (required for comics)
# https://comicvine.gamespot.com/api
COMICVINE_API_KEY=

# IGDB — games (required for games, via Twitch)
# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Fanart.tv — extra artwork (optional)
# https://fanart.tv/get-an-api-key/
FANART_API_KEY=

# ── Paths (optional — defaults shown) ─────────────────────────────────────────
# ARCHIVIST_CONFIG=./config.toml
# ARCHIVIST_DB=./data/archivist.sqlite
# ARCHIVIST_MEDIA_BASE=./media
# ARCHIVIST_DEFINITIONS_PATH=./data/indexer-definitions

# ── Server ─────────────────────────────────────────────────────────────────────
# ARCHIVIST_PORT=2424
# HOST=0.0.0.0
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PLAYER_ORIGINS=http://localhost:4242,http://127.0.0.1:4242
# Living-room Player v2 remains opt-in during the rollback window.
# PLAYER_UI_V2_ENABLED=true   # living-room UI is the default; set false to fall back to the legacy player
# PLAYER_UI_DEFAULT_PRESET=categories
# PLAYER_UI_MAX_WIDGET_ITEMS=36
# PLAYER_UI_TELEMETRY_ENABLED=false
# Internal API/service token used by the Player proxy; not an Admin login credential.
# Generate with: openssl rand -hex 32
# ARCHIVIST_API_TOKEN=
# ARCHIVIST_JSON_LIMIT=1mb
# LOG_LEVEL=info
# LOG_FORMAT=text
# DEFINITIONS_OFFLINE=false

# ── Built-in torrent engine ───────────────────────────────────────────────────
# Transmission-style flow: torrents download into TORRENT_INCOMPLETE_DIR, then
# the engine moves the finished payload into TORRENT_DOWNLOAD_DIR (…/complete)
# on completion, from where it is imported into the media library. Both live
# under the ./downloads volume mounted in docker-compose (./downloads:/app/downloads).
# TORRENT_INCOMPLETE_DIR=./downloads/incomplete
# TORRENT_DOWNLOAD_DIR=./downloads/complete
# TORRENT_RESUME_DIR=./data/resume
# TORRENT_FILES_DIR=./data/torrents
# ARCHIVIST_EMBEDDED_TORRENTS=true
# TORRENT_PEER_PORT=2425
# TORRENT_DHT_PORT=2426
# TORRENT_UTP_PORT=2427

# ── Player and imports ────────────────────────────────────────────────────────
# ARCHIVIST_TRANSCODE_CONCURRENCY=2
# ARCHIVIST_LOUDNESS_CONCURRENCY=2
# Recurring TV segment analysis is opt-in. It can also be enabled from
# Settings → System → Skip Intro & Credits.
# ARCHIVIST_SKIP_INTRO_ENABLED=false
# ARCHIVIST_SEGMENT_CONCURRENCY=1
# ARCHIVIST_SEGMENT_SWEEP_MAX=50
# ARCHIVIST_SEGMENT_CHILD_TIMEOUT_MS=90000
# REMOTE_PATH_MAP=/downloads:/app/downloads/complete

# ── Security ───────────────────────────────────────────────────────────────────
# Directories that API callers may reference by absolute path (comma-separated).
# Affects the file-metadata / track-cleaning endpoints and root-folder creation.
# When unset, Archivist confines file operations to the media base, the download
# directories and any declared root folders — set this only to narrow it further.
# ARCHIVIST_ALLOWED_ROOTS=/app/media,/app/downloads

# Set when running behind a reverse proxy (nginx, Traefik, Caddy, Cloudflare).
# Rate limiting keys on the client IP; without this every request appears to come
# from the proxy, so the whole household shares one bucket and the login limiter
# becomes a global lockout. Leave UNSET when exposed directly — trusting
# X-Forwarded-For with no proxy in front lets a client spoof its own identity.
# Accepts 'loopback', a subnet, a hop count, or 'true'.
# TRUST_PROXY=loopback

# ── Ports and hosts ────────────────────────────────────────────────────────────
# PORT / ARCHIVIST_HOST are aliases for ARCHIVIST_PORT / HOST above.
# PORT=2424
# ARCHIVIST_HOST=0.0.0.0
# PLAYER_PORT=4242
# Advertised to peers when behind NAT/port-forwarding.
# TORRENT_TCP_PORT=2425
# TORRENT_ADVERTISE_PORT=
# TORRENT_PEER_HOST=

# ── Additional paths ───────────────────────────────────────────────────────────
# ARCHIVIST_BACKUP_DIR=./data/backups
# ARCHIVIST_QUARANTINE_DIR=./data/quarantine
# ARCHIVIST_DOWNLOAD_DIR=./downloads/complete
# ARCHIVIST_SHARED_DB=./data/archivist.sqlite
# Built assets — set by the Docker image; override only for custom deployments.
# ARCHIVIST_SPA_DIR=./client/dist
# ARCHIVIST_PLAYER_DIR=./apps/player/dist
# ARCHIVIST_EJS_DIR=./emulatorjs

# ── External binaries ──────────────────────────────────────────────────────────
# Bundled via ffmpeg-static/ffprobe-static; override to use system builds.
# ARCHIVIST_FFMPEG_PATH=
# fpcalc (Chromaprint) enables audio fingerprinting for music matching.
# ARCHIVIST_FPCALC_PATH=
# MAX_CONCURRENT_ENCODES=2

# ── Provider API base URLs ─────────────────────────────────────────────────────
# Override only to point at a mirror or a test double; defaults are the real APIs.
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TVDB_BASE_URL=https://api4.thetvdb.com/v4
# SKYHOOK_BASE_URL=https://skyhook.sonarr.tv/v1
# MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
# COVERART_BASE_URL=https://coverartarchive.org
# FANART_BASE_URL=https://webservice.fanart.tv/v3
# FANART_TV_BASE_URL=https://webservice.fanart.tv/v3
# GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
# OPENLIBRARY_BASE_URL=https://openlibrary.org
# COMICVINE_BASE_URL=https://comicvine.gamespot.com/api
# IGDB_BASE_URL=https://api.igdb.com/v4
# TWITCH_OAUTH_URL=https://id.twitch.tv/oauth2/token
