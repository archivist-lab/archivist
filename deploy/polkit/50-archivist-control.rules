/* Archivist Control may manage only its paired Archivist runtime service. */
polkit.addRule(function (action, subject) {
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    subject.user === 'archivist-control' &&
    subject.system_unit === 'archivist-control.service'
  ) {
    var unit = action.lookup('unit')
    var verb = action.lookup('verb')
    var allowedVerb = verb === 'start' || verb === 'stop' || verb === 'restart'

    if (unit === 'archivist.service' && allowedVerb) return polkit.Result.YES
    return polkit.Result.NO
  }

  return polkit.Result.NOT_HANDLED
})
