<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The canvas colour from the design system, so launch never flashes white. -->
    <color name="archivist_canvas">#0A0A0F</color>

    <style name="Theme.Archivist" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/archivist_canvas</item>
        <item name="android:colorBackground">@color/archivist_canvas</item>
        <item name="android:colorAccent">#00D4FF</item>
        <item name="android:statusBarColor">@color/archivist_canvas</item>
        <item name="android:navigationBarColor">@color/archivist_canvas</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
