{
  "name": "archivist-android-tv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Archivist for Android TV and Fire TV — a native Compose for TV and ExoPlayer app, with the server's web Player kept for music, books and games.",
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p web",
    "test": "vitest run --config web/vite.config.ts",
    "apk": "bash scripts/build.sh"
  },
  "dependencies": {
    "@archivist/design-system": "workspace:*",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "25.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "2.1.9"
  }
}
