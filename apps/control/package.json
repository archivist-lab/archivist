{
  "name": "archivist-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:ui": "vite --host 0.0.0.0 --port 2430",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "build": "pnpm build:server && pnpm build:ui",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@archivist/design-system": "workspace:*",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
